{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1.3",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "jobswiper@jobswiper.ai",
      "strict_min_version": "121.0"
    }
  },
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://*.indeed.fr/*",
    "https://*.indeed.de/*",
    "https://*.indeed.co.uk/*",
    "https://*.indeed.co.in/*",
    "https://*.indeed.ca/*",
    "https://*.indeed.com.au/*",
    "https://*.linkedin.com/*",
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.fr/*",
    "https://*.glassdoor.de/*",
    "https://jobswiper.ai/*",
    "https://www.jobswiper.ai/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.icims.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.taleo.net/*",
    "https://*.workable.com/*",
    "https://*.breezy.hr/*",
    "https://*.ashbyhq.com/*",
    "https://*.recruitee.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jazz.co/*",
    "https://*.jobup.ch/*",
    "https://*.jobs.ch/*",
    "https://*.welcometothejungle.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobswiper.ai/*",
        "https://www.jobswiper.ai/*"
      ],
      "js": ["content/detect.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*"],
      "js": ["utils/extract-helpers.js", "content/apply-shared.js", "content/autofill.js", "content/cv-attach.js", "content/sidebar.js"],
      "css": ["content/jobswiper.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.workable.com/*",
        "https://*.recruitee.com/*",
        "https://*.breezy.hr/*",
        "https://*.bamboohr.com/*",
        "https://*.jazz.co/*",
        "https://*.applytojob.com/*"
      ],
      "all_frames": true,
      "js": ["content/apply-shared.js", "content/autofill.js", "content/cv-attach.js"],
      "css": ["content/jobswiper.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png", "icons/icon48.png", "fonts/nunito-latin.woff2"],
      "matches": ["https://*/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
